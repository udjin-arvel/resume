# PostgreSQL
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_dev
POSTGRES_DB=crm
DATABASE_URL=postgres://crm:crm_dev@localhost:5432/crm?sslmode=disable

# Backend
APP_ENV=dev
APP_URL=http://localhost:3000
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=
TELEGRAM_BOT_TOKEN=
REGISTRATION_ENABLED=true
MANAGER_INVITE_SECRET=
# Must match VITE_WORKER_INVITE_SECRET in client build
WORKER_INVITE_SECRET=

# Ports
API_PORT=8080
CORS_ORIGINS=http://localhost:3000
