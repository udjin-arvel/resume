# Server Configuration
HOST=0.0.0.0
PORT=8090
DEBUG=False

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# OpenAI: Assistants (промпты из топика prompt_jobs) + QC vision в Atlas
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7
OPENAI_PROXY=
MOCK_OPENAI=false
OPENAI_FALLBACK_SIMPLE_ON_ASSISTANTS_ERROR=true
IS_PROMPT_LOG_ENABLE=0

# Runway Configuration
RUNWAY_API_KEY=your_runway_api_key_here
RUNWAY_API_URL=https://dev.runwayml.com
RUNWAY_TIMEOUT=300

# Request Configuration
REQUEST_TIMEOUT=60
MAX_REQUEST_SIZE=10485760

# Atlas Cloud AI (генерация через proxy; см. services/atlasai_service.py)
# ATLAS_TIMEOUT — POST старта для изображений (сек); ATLAS_TIMEOUT_VIDEO — для видео (дольше).
# Опрос GET /model/prediction/{id}: для картинок — лимит попыток ATLAS_MAX_ATTEMPTS; для видео отдельно ATLAS_MAX_ATTEMPTS_VIDEO.
# ATLAS_POLL_MAX_WAIT_* — потолок по времени опроса (сек). 0 = без лимита по времени (только по числу попыток).
# Дефолты в коде: ~15 мин / ~30 мин по времени; для очень медленных видео можно 3600+ и больший ATLAS_MAX_ATTEMPTS_VIDEO.
ATLAS_API_KEY=
ATLAS_API_URL=https://api.atlascloud.ai/api/v1
ATLAS_TIMEOUT=60
ATLAS_TIMEOUT_VIDEO=300
ATLAS_MAX_ATTEMPTS=500
ATLAS_MAX_ATTEMPTS_VIDEO=1200
ATLAS_POLL_MAX_WAIT_IMAGE_SEC=900
ATLAS_POLL_MAX_WAIT_VIDEO_SEC=1800
# Интервалы опроса статуса prediction (первый GET — сразу после POST, далее равномерно по интервалу).
ATLAS_POLL_INTERVAL_IMAGE_SEC=3
ATLAS_POLL_INTERVAL_VIDEO_SEC=4
ATLAS_POLL_JITTER_RATIO=0.15
ATLAS_POLL_429_DEFAULT_SEC=5
ATLAS_POLL_429_SLEEP_MIN_SEC=1
ATLAS_POLL_429_SLEEP_MAX_SEC=120
# Таймауты connect/read для GET статуса prediction (сек.); при сбое — до 3 повторов с backoff.
ATLAS_POLL_CONNECT_TIMEOUT_SEC=60
ATLAS_POLL_READ_TIMEOUT_SEC=60
ATLAS_POST_MAX_429_RETRIES=2
# GET результата с CDN Atlas (видео / изображение), сек.: read-таймаут — основной порог против ReadTimeout на больших файлах
ATLAS_RESULT_DOWNLOAD_TIMEOUT_VIDEO_SEC=900
ATLAS_RESULT_DOWNLOAD_TIMEOUT_IMAGE_SEC=240
# Предвалидация reference images до POST в Atlas (HEAD/GET + Content-Type + magic bytes JPEG/PNG)
ATLAS_REF_IMAGE_VALIDATION_ENABLED=false
MOCK_ATLAS_AI=false

# Backend: origin + path. /task, /storage GET, /api/config; URL в Atlas (reference_images, video) — тот же BACKEND_URL.
# Для Atlas с интернета задайте публичный HTTPS (GET /storage/{user_id}/… без auth), не http://api:8000.
BACKEND_URL=http://api:8000
# Deprecated: результаты генерации передаются через Kafka (result_source_url), не POST /storage/file.
# BACKEND_STORAGE_UPLOAD_SECRET=
# BACKEND_STORAGE_UPLOAD_TIMEOUT=600
# Общий секрет с backend для подписи origin в Kafka (requests); должен совпадать с BACKEND_PROXY_HMAC_SECRET на backend
BACKEND_PROXY_HMAC_SECRET=
# true: сообщения без backend_api_base/hmac используют только BACKEND_URL (обратная совместимость)
BACKEND_PROXY_ALLOW_LEGACY_UNSIGNED=true

# Kafka: dev и prod не должны использовать одни и те же requests/results/dialogs topics.
# Пример для prod: requests-prod / results-prod / dialogs-prod
# Пример для dev: requests-dev / results-dev / dialogs-dev
# Dev + Kafka в Docker на этой же машине (kafka-network): kafka:29092
# Prod, Kafka на другом сервере: тот же host:port, что в KAFKA_ADVERTISED_EXTERNAL на брокере
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_CONSUMER_GROUP_ID=radar_backend_proxy_dev
# Один топик или несколько через запятую (одна consumer group на все)
KAFKA_TOPIC_REQUESTS=requests-dev
# Один топик или несколько через запятую — копия результата уйдёт в каждый (например results-dev,results-prod)
KAFKA_TOPIC_RESULTS=results-dev
KAFKA_TOPIC_DIALOGS=dialogs-dev
# Backend кладёт сюда задачи «нужен GPT»; consumer на proxy → затем публикация в KAFKA_TOPIC_REQUESTS
KAFKA_TOPIC_PROMPT_JOBS=prompt_jobs-dev
# Параллелизм обработки prompt_jobs (как KAFKA_REQUESTS_MAX_CONCURRENCY для requests)
KAFKA_PROMPT_JOBS_MAX_CONCURRENCY=3

# SSH: туннель к prod OpenSearch Dashboards — `make logs-dashboard` (нужен пакет sshpass).
# Пароль передаётся через переменную окружения SSHPASS внутри sshpass, не указывайте его в командной строке.
SSH_DASHBOARD_PASSWORD=password
# SSH_DASHBOARD_USER=user
# SSH_DASHBOARD_HOST=host
