# Git / IDE
.git
.gitignore
.cursor
.project

# Env (secrets stay on host)
.env
.env.*
!.env.example

# Python backend (separate image)
backend/.venv
backend/**/__pycache__

# Client — never copy host node_modules into Linux build
client/node_modules
