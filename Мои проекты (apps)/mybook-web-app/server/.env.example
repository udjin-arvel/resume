# Database
DATABASE_URL="postgresql://thebook_user:thebook_password@localhost:5432/thebook?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
AUTH_COOKIE_NAME="thebook_token"

# Server
PORT=3001
NODE_ENV=development

# File upload
UPLOAD_PATH="./uploads"
MAX_FILE_SIZE=5242880 # 5MB 