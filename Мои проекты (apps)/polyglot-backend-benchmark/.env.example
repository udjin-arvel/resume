# PostgreSQL (local demo only — do not use in production)
DB_HOST=pg
DB_PORT=5432
DB_NAME=polyglot
DB_USER=polyglot
DB_PASSWORD=polyglot
DB_POOL_SIZE=20

# Backend ports (host)
PORT_GO=8081
PORT_NODE=8082
PORT_PHP=8083
PORT_PYTHON=8084
PORT_CLIENT=8080

LOG_LEVEL=warn

# Client build (empty = use /api/<backend> via nginx)
VITE_API_BASE_GO=/api/go
VITE_API_BASE_NODE=/api/node
VITE_API_BASE_PHP=/api/php
VITE_API_BASE_PYTHON=/api/python
