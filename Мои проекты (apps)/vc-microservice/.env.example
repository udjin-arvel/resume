# Порт, на котором nginx доступен снаружи (http://localhost:8080)
HTTP_PORT=8080

# Число параллельных FFmpeg-процессов
WORKERS=2
# Буфер очереди; при переполнении — 429
QUEUE_SIZE=100
# Лимит размера файла, МБ (nginx: client_max_body_size 201m — держать в согласии)
MAX_UPLOAD_MB=200
# Таймаут одной конвертации
FFMPEG_TIMEOUT=10m
# Время жизни результата и записи о задаче
FILE_TTL=1h
# Как часто запускать очистку
CLEANUP_INTERVAL=10m
# Сколько ждать текущие задачи при остановке
SHUTDOWN_TIMEOUT=30s

# Параметры x264
CRF=23
PRESET=veryfast

# info | debug
LOG_LEVEL=info
