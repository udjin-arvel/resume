    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^18.1.0",
    "tesseract.js": "^6.0.1",
    "typeorm": "^0.3.23",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
